# ntm-server.service — installed by the ntm-server RPM (packaging/rpm/).
#
# Binary and its NTMSIG 2 signature: /usr/bin/ntm-server + /usr/bin/ntm-server.sig (RPM-owned;
# updates come from dnf, not the built-in self-update). Configure before enabling —
# see /usr/share/doc/ntm-server/SERVER_DEPLOYMENT.md, then: systemctl enable --now ntm-server

[Unit]
Description=Network Monitor Server Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
ExecStart=/usr/bin/ntm-server \
    --daemon \
    --config /etc/ntm-server/ntm-server.conf
Restart=on-failure
RestartSec=5s

User=ntm-server
Group=ntm-server
WorkingDirectory=/var/lib/ntm-server
RuntimeDirectory=ntm-server
StateDirectory=ntm-server
LogsDirectory=ntm-server

# Allow the server to read its config and write WebAuthn credential files.
# Required because ProtectSystem=strict makes the filesystem read-only by default.
ReadWritePaths=/var/lib/ntm-server /etc/ntm-server

# ── Security hardening ────────────────────────────────────────────────────────

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

# MemoryDenyWriteExecute must NOT be enabled. OpenSSL uses mprotect() internally
# for hardware-accelerated ciphers (AES-NI etc.), which this option blocks with
# EPERM. That causes the HTTPS SSL context to fail initialisation and the web
# dashboard to be silently disabled while the ingestion port continues running.
# MemoryDenyWriteExecute=true   # <-- do not uncomment

PrivateDevices=true

# PrivateUsers must NOT be enabled. It creates a user namespace that interferes
# with OpenSSL privilege checks and socket operations, producing the same silent
# dashboard failure as MemoryDenyWriteExecute. It is also redundant here because
# the service already runs as the unprivileged dedicated user ntm-server.
# PrivateUsers=true   # <-- do not uncomment

ProtectProc=invisible
ProcSubset=pid

# Restrict the service to the socket address families it actually needs.
# This provides equivalent attack-surface reduction to PrivateUsers without
# breaking TLS.
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
