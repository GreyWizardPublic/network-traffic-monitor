# ntm-client: single config file (key=value, # comment)
# Usage: ntm-client --config /path/to/this/file
# All keys are optional; defaults apply when omitted or when not using --config.
# Command-line options (--server, --port, --identity, --ca, --server-cert, etc.) override these when set.

# Server host to connect to. Default 127.0.0.1.
server=127.0.0.1

# Server port (1-65535). Default 5555.
port=5555

# Path to Ed25519 client private key PEM (for authentication). Omit or leave empty for no auth.
# identity=/path/to/client_private.pem

# TLS: path to CA bundle (PEM) to verify server certificate. Omit or leave empty to skip CA verification (or use server_cert).
# ca=/path/to/ca.pem

# TLS: path to server certificate (PEM) for pinning. Omit or leave empty to use CA or plain TCP.
# server_cert=/path/to/server_cert.pem

# Send buffer size in bytes; clamped to 4096-2097152. Default 524288.
send_buffer_bytes=524288

# External IP check: used to group clients behind the same NAT as one physical LAN.
# The client performs a plain HTTP GET to this URL and expects the response body to be
# the client's public IPv4 or IPv6 address. Only queried when a LAN interface is present.
# Default: http://checkip.amazonaws.com/
# external_ip_url=http://checkip.amazonaws.com/

# Timeout (ms) for the external IP HTTP request. Default 5000.
# external_ip_timeout_ms=5000

# ── Auto-update ───────────────────────────────────────────────────────────────
#
# Enable automatic binary updates via the server's HTTPS API.
# Default: false (opt-in). Set to true to enable.
# auto_update=false

# HTTPS API port for update checks (same server as wire protocol).
# Default: 8443 (matches server default web_port).
# update_port=8443
