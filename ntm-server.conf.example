# ntm-server: single config file (key=value, # comment)
# Usage: ntm-server --config /path/to/this/file
# All keys are optional; defaults apply when omitted or when not using --config.
# Command-line options override these when set.

# ── Data ingestion port ──────────────────────────────────────────────────────

# TCP port on which ntm-client instances send packet metadata (1-65535). Default 5555.
# port=5555

# Bind address for the client ingestion port. Empty = 0.0.0.0 (all interfaces).
# client_bind=

# Path to file with allowed Ed25519 public keys (one 64-char hex line per client).
# MANDATORY: the server refuses to start if this is not set or the file contains no valid keys.
allowed_keys=/etc/ntm-server/allowed_clients.txt

# TLS: server certificate and private key (PEM) shared by the ingestion port and the
# HTTPS web dashboard.
# MANDATORY: the server refuses to start without a valid cert/key pair.
# Plain TCP connections are always refused.
cert=/etc/ntm-server/server_cert.pem
key=/etc/ntm-server/server_key.pem

# require_tls: obsolete. TLS is now always enforced and this option is ignored.

# ── HTTPS web dashboard ──────────────────────────────────────────────────────
#
# The web dashboard is an HTTPS-only endpoint that serves a browser-based
# monitoring UI.  Connections are accepted from RFC 1918 LAN addresses only
# (10.x.x.x, 172.16-31.x.x, 192.168.x.x, loopback); all other source IPs are
# rejected at the application layer regardless of bind address.
#
# IMPORTANT: the web dashboard requires cert= and key= to be set. If they are
# absent, the web dashboard is disabled (no plaintext fallback is created).

# HTTPS port for the web dashboard (1-65535). 0 = disabled. Default 8443.
# web_port=8443

# Bind address for the web dashboard (IPv4). Default 0.0.0.0 (all interfaces).
# The LAN-only IP filter enforces the security boundary regardless of this setting.
# web_bind=0.0.0.0

# Optional static bearer token.  When set, every web request must include:
#   Authorization: Bearer <token>
# Requests without a valid token receive HTTP 401.
# If unset, access is limited to LAN IPs + HTTPS only (no per-user auth).
# Recommended for any deployment where other users share the LAN.
# web_token=

# Max web requests per IP per minute (0 = unlimited). Default 30.
# web_rate_limit_rpm=30

# ── Aggregation ──────────────────────────────────────────────────────────────

# Rolling aggregation window in days (1-365). When window+1 days exist, only the oldest day is dropped.
aggregation_window_days=7

# IP -> Country / ASN database (replaces libmaxminddb / GeoLite2).
# Data source: iptoasn.com (CC0 public domain). The server keeps a local cache at
# ip_db_path and automatically re-downloads it every ip_db_update_interval_days.
ip_db_path=/var/lib/ntm-server/ip2asn-combined.tsv.gz
ip_db_url=https://iptoasn.com/data/ip2asn-combined.tsv.gz
ip_db_update_interval_days=7
ip_db_auto_update=true

# ── Resource limits ──────────────────────────────────────────────────────────

# Per-connection receive buffer cap in bytes; connection closed if exceeded (4096-16M).
max_recv_buffer_bytes=1048576

# Per (client|iface) per day: max flow entries; evict smallest by bytes when over (100-1000000).
max_flow_entries_per_key=100000
max_entity_flow_entries_per_key=100000

# Per client: hard cap on the number of distinct iface names accepted (1-100000).
max_ifaces_per_client=256

# Web summary: max entity rows returned in /api/summary (100-1000000). Default 50000.
max_entity_lines_in_summary=50000

# Stderr printer: skip per-interface detail when snapshot exceeds this many entries (1000-2000000).
max_snapshot_entries_for_print=200000

# D line field max length: iface (8-256), src_ip/dst_ip (15-64). Longer fields are rejected.
max_iface_len=64
max_ip_len=50

# Connection limits: global concurrent connections (10-100000), per-IP concurrent (1-1000).
max_concurrent_connections=1000
max_connections_per_ip=20

# Idle timeout: close connection after this many seconds without data (10-86400).
idle_timeout_seconds=300

# Per-connection D line rate limit: max D lines processed per second; excess dropped (100-1000000).
max_d_lines_per_second_per_connection=20000
